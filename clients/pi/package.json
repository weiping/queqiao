{
  "name": "@weiping/pi-magpie-bridge",
  "version": "0.2.2",
  "description": "Route every Pi turn across mbridge's fast/balanced/performance tiers via the mbridge gateway.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/mbridge.js"
    ]
  },
  "type": "module",
  "main": "./extensions/mbridge.js",
  "types": "./extensions/mbridge.d.ts",
  "files": [
    "extensions",
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run check && npm test"
  },
  "author": {
    "name": "weiping"
  },
  "license": "MIT"
}
